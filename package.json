{
    "name": "media_viewer",
    "version": "1.0.0",
    "description": "Electron desktop application for browsing, rating, and managing media files with visual similarity sorting and ML-based prediction features.",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "test": "echo \"Error: no test specified\" && exit 1",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky || true"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,html}": [
            "prettier --write"
        ]
    },
    "author": "goodalex223",
    "license": "MIT",
    "dependencies": {
        "@vladmandic/face-api": "^1.7.15",
        "blockhash": "^0.2.0",
        "ffprobe-static": "^3.1.0"
    },
    "devDependencies": {
        "electron": "^39.1.2",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "prettier": "^3.8.1"
    }
}
